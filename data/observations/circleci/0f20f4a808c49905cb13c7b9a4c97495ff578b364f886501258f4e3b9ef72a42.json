    "updates": [
      {
        "native_id": "gq4xf3yl31tr",
        "status": "investigating",
        "body": "Some Smarter Testing customers may not be able to run tests.\n\nWe are also seeing delays updating the impact analysis data map, which may cause more tests to be selected by Smarter Testing.",
        "created_at": "2026-11-19T16:34:11.653Z"
      },
      {
        "native_id": "kx3wrx9qwgcl",
        "status": "identified",
        "body": "Starting at 16:38 UTC, test jobs for customers using Smarter Testing should be back running. Dynamic Test Splitting may still not be working optimally for some customers.",
        "created_at": "2026-11-19T17:04:41.243Z"
      },
      {
        "native_id": "4v5vq9xfph5q",
        "status": "identified",
        "body": "Since 17:09 UTC, we have been seeing delays in updating test impact analysis data.\n\nTest selection may be less precise, which may cause more tests than necessary to run. Thank you for your patience while our engineers work to resolve this.",
        "created_at": "2026-11-19T17:30:29.464Z"
      },
      {
        "native_id": "gbx8gvvx0q9w",
        "status": "identified",
        "body": "Since 17:38 UTC, some test jobs for customers using Smarter Testing have been failing.\n\nThank you for your patience while our engineers work to resolve this.",
        "created_at": "2026-11-19T17:45:38.381Z"
      },
      {
        "native_id": "4rs9t3bv3m5b",
        "status": "identified",
        "body": "Since 17:55 UTC, test jobs for customers using Smarter Testing have been running again.\n\nDynamic Test Splitting is still not running optimally.\n\nDynamic Parallelism is also not running optimally, so jobs that use it should be expected to fall back to using all nodes.\n\nThank you for your patience while our engineers work to resolve this.\n\nWe will provide another update by 18:30 UTC.",
        "created_at": "2026-11-19T18:13:12.688Z"
      },
      {
        "native_id": "c9vghpmr7qst",
        "status": "identified",
        "body": "Since 17:55 UTC, test jobs for customers using Smarter Testing have been running again.\n\nDynamic Test Splitting is still not running optimally.\n\nDynamic Parallelism is also not running optimally, so jobs that use it should be expected to fall back to using all nodes.\n\nThank you for your patience while our engineers work to resolve this.\n\nWe will provide another update by 18:50 UTC",
        "created_at": "2026-11-19T18:30:34.84Z"
      },
      {
        "native_id": "vqt2sl0j682l",
        "status": "identified",
        "body": "At 18:45 UTC, we will perform emergency maintenance, which is expected to take a few minutes. During this window, test jobs for customers using Smarter Testing may be delayed or fail.\n\nThank you for your patience while our engineers work to resolve this.\nWe will provide another update by 19:05 UTC.",
        "created_at": "2026-11-19T18:40:41.768Z"
      },
      {
        "native_id": "cs7q3bdy132l",
        "status": "monitoring",
        "body": "The maintenance was successful. Smarter Testing functionality has been restored.\n\nWe are monitoring to ensure performance remains stable.",
        "created_at": "2026-11-19T19:08:10.618Z"
      },
      {
        "native_id": "p21hy8pb9xqc",
        "status": "resolved",
        "body": "Smarter Testing functionality is restored.\n\nWe appreciate your patience as we worked through this.",
        "created_at": "2026-11-19T19:22:09.927Z"
      }
