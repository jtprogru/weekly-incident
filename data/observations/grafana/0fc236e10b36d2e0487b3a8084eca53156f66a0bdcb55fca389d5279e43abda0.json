    "updates": [
      {
        "native_id": "ysfll1cfb49q",
        "status": "investigating",
        "body": "We are investigating increased authentication errors affecting Grafana Cloud in the prod-us-west-0 region.\n\nCustomers may experience intermittent failures for requests that require authentication.\n\nOur engineering team has identified database performance degradation affecting the authentication service and is investigating the underlying cause.\n\nWe will provide another update as more information becomes available.",
        "created_at": "2026-10-14T12:57:24.259Z"
      },
      {
        "native_id": "djzpnrkrmf5m",
        "status": "identified",
        "body": "The issue has been identified, and we have applied mitigations on our end. We are currently observing the progress.",
        "created_at": "2026-10-14T13:58:12.45Z"
      },
      {
        "native_id": "lh3995n2d91m",
        "status": "identified",
        "body": "We have noticed improvements across services. We will now be applying a more permanent fix. Impacted users may experience a disruption in the auth-api service of up to 15min while we apply a DB patch that will improve performance.",
        "created_at": "2026-10-14T15:00:04.003Z"
      },
      {
        "native_id": "l7w9mk9dzzx6",
        "status": "monitoring",
        "body": "The fix has been implemented, and we are monitoring the results.",
        "created_at": "2026-10-14T15:25:26.834Z"
      },
      {
