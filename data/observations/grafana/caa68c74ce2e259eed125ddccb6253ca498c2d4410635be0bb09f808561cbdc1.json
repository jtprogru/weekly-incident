    "updates": [
      {
        "native_id": "w6jbdy9lc1rc",
        "status": "investigating",
        "body": "We are currently facing an issue where Stacks using SCIM user provisioning are currently unable to log into Grafana. We are currently investigating this issue and working on a fix.",
        "created_at": "2026-07-23T10:13:15.524Z"
      },
      {
        "native_id": "0lkmmc337rx9",
        "status": "identified",
        "body": "The issue has been identified and we are currently working on the mitigations now. The scope is much more limited than initially thought only specific SCIM configurations are impacted.",
        "created_at": "2026-07-23T11:26:07.143Z"
      },
      {
        "native_id": "p9c6l431htbh",
        "status": "identified",
        "body": "We have applied a fix and are currently awaiting feedback from affected customers.",
        "created_at": "2026-07-23T13:23:00.323Z"
      },
