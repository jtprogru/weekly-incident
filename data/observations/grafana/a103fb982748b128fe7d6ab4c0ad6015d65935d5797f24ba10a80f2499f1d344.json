    "updates": [
      {
        "native_id": "jvby54c1p6gh",
        "status": "identified",
        "body": "Queries with drop __error__, including log volume histogram queries (the queries that generate the histogram visualization in Grafana), are failing due to a bug with series limit checks.\n\nThe Root cause has been identified, and we are working on a fix.",
        "created_at": "2026-07-02T18:10:30.168Z"
      },
      {
        "native_id": "yr1btz2hnyj0",
        "status": "identified",
        "body": "We are continuing to work on rolling back a PR responsible for this behavior. Once we have more information, we will share it here. \n\nThank you for your patience.",
        "created_at": "2026-07-02T20:16:01.243Z"
      },
      {
        "native_id": "tglx0m7nl028",
        "status": "resolved",
        "body": "This incident has been resolved. Thank you for your patience.",
        "created_at": "2026-07-02T21:35:48.102Z"
      }
    ],
