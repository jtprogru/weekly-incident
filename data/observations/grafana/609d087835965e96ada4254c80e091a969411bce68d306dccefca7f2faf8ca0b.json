    "updates": [
      {
        "native_id": "bz9hzhz7s1y7",
        "status": "investigating",
        "body": "We are investigating an issue affecting Loki queries in prod-eu-west-2.\n\nWe first observed this behavior at approximately 21:57 UTC. Affected users may see elevated query errors, timeouts, or intermittent failures when running Loki queries in this region.\n\nThe issue appears to be improving, but it is not fully resolved yet. We are continuing to investigate and will share another update as soon as we have more information.",
        "created_at": "2026-07-15T22:24:44.963Z"
      },
      {
        "native_id": "wdx8lw1ldbv1",
        "status": "investigating",
        "body": "We are investigating a broader issue affecting multiple Grafana Cloud products in prod-eu-west-2. This appears to be caused by a third-party provider issue rather than a Loki-specific problem.\n\nImpact is currently inconsistent: some components are affected while others continue to function normally. We have also seen some impact to Tempo write paths.\n\nWe are continuing to investigate and will share another update as soon as we have more information.",
        "created_at": "2026-07-15T22:35:15.934Z"
      },
      {
        "native_id": "4xrbbnp62j2t",
        "status": "investigating",
        "body": "We are continuing to investigate this issue.",
        "created_at": "2026-07-15T22:38:56.425Z"
      },
      {
        "native_id": "tdy98byl04qs",
        "status": "monitoring",
        "body": "We’ve implemented a fix and are monitoring the results to confirm the issue is fully resolved. Services may start to recover during this time.",
        "created_at": "2026-07-15T22:53:45.22Z"
      },
      {
        "native_id": "rm7h9r64zf1d",
        "status": "resolved",
        "body": "This incident has been resolved. Thank you for your patience.",
        "created_at": "2026-07-15T23:36:59.315Z"
      }
    ],
