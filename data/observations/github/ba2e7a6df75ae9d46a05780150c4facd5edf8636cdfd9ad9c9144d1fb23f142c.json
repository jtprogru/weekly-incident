      {
        "native_id": "h6vgnlsv8jkc",
        "status": "investigating",
        "body": "We're investigating degraded performance and errors affecting several GitHub services, including Git operations, Issues, Actions, and API access. Some users may see failed requests or slow responses. We'll post another update by 00:05 UTC.",
        "created_at": "2026-11-05T23:36:51.582Z"
      },
      {
        "native_id": "lqzh65wtfdy1",
