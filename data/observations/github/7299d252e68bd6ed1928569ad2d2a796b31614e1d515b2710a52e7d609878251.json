      },
      {
        "native_id": "pfjqjdcjg2mx",
        "status": "resolved",
        "body": "On November 2, 2026, between 17:30 and 18:10 UTC, background tasks such as generating commit messages in GitHub Copilot were degraded. This was due to elevated errors with GPT-5.4 nano, a utility model. The elevated errors originated from an issue with an upstream model provider. No models that users could pick in the model picker were impacted. Service recovered when the upstream provider released a fix. We are working with the provider to understand the root cause and prevent similar issues from occurring going forward.",
        "created_at": "2026-11-02T18:24:23.169Z"
      }
    ],
