    ],
    "updates": [
      {
        "native_id": "p5bbmxlmshz0",
        "status": "investigating",
        "body": "Cloudflare is aware, and investigating an issue affecting availability in ENAM for a small number of R2 buckets.",
        "created_at": "2026-08-07T18:42:26.295Z"
      },
      {
        "native_id": "7plcrlxh4d49",
        "status": "identified",
        "body": "We have identified the cause and mitigated further impact. Writes to a small set of buckets in ENAM were impacted between 14:52-17:02 UTC. We are continuing to work to restore normal availability for these buckets.",
        "created_at": "2026-08-07T22:54:11.666Z"
      },
      {
        "native_id": "61rdnrdt6k1b",
        "status": "identified",
        "body": "We are continuing to work on a fix for this issue.",
        "created_at": "2026-08-07T23:05:19.797Z"
      },
      {
        "native_id": "pqkrrkkd1g7m",
        "status": "identified",
        "body": "We are continuing to restore availability for impacted R2 buckets in ENAM. Recovery is progressing well, and we will provide status updates as they becomes available",
        "created_at": "2026-08-08T10:52:56.048Z"
      },
      {
        "native_id": "fqjtwnj5gc7k",
        "status": "identified",
        "body": "Availability has been restored for nearly all impacted R2 buckets. A small number of objects uploaded through multipart uploads in ENAM between 14:52 and 17:02 UTC on August 7 remain unavailable. We are continuing to restore access and expect to be able to provide another update soon.",
        "created_at": "2026-08-08T23:28:09.074Z"
      },
      {
        "native_id": "n8kwl4kffmsy",
        "status": "resolved",
        "body": "Availability has now been fully restored for all impacted R2 buckets, including the remaining objects uploaded through multipart uploads in ENAM.",
        "created_at": "2026-08-09T02:35:44.434Z"
      }
    ],
