      {
        "native_id": "wstw0lgl9nuq",
        "status": "investigating",
        "body": "Cloudflare has identified an issue that causes intermittent DNS errors for a small subset of Cloudflare Workers subrequests to origins. Affected subrequests return HTTP 403 with Cloudflare error 1000. Impact is concentrated in Columbus, Dallas, São Paulo and Atlanta. No customer action is required. Public authoritative DNS is not affected. We are actively working to mitigate the impact and resolve the issue.",
        "created_at": "2026-11-28T04:45:43.228Z"
      },
