      },
      {
        "native_id": "qjgttkq5js1p",
        "status": "investigating",
        "body": "We are investigating reports of degraded performance affecting claude.ai, the Claude API, Claude Code, and connectors (including Claude Docs and Claude Sheets).",
        "created_at": "2026-11-13T13:52:05.519Z"
      },
      {
        "native_id": "23hjttljw844",
        "status": "investigating",
        "body": "We are investigating reports of degraded performance affecting a variety of surfaces including claude.ai, the Claude API, Claude Code, connectors (including Claude Docs and Claude Sheets), Claude Security and Claude Managed Agents.",
        "created_at": "2026-11-13T14:03:47.245Z"
      },
      {
        "native_id": "0ggxgd9jm4jt",
        "status": "investigating",
        "body": "We're seeing recovery on claude.ai and the Claude API, though errors may return while we continue working on this. Connectors, including Docs and Sheets, remain degraded, as do Claude in Meetings, Claude Managed Agents, Claude Security and connector use in Claude Code. Mobile apps are affected in the same way as claude.ai. We'll share another update soon.",
        "created_at": "2026-11-13T14:36:13.852Z"
      },
      {
        "native_id": "0yhr32xnhr2t",
        "status": "monitoring",
        "body": "Errors on claude.ai, including the mobile apps, the Claude API and Claude Code have returned to normal levels, and we are continuing to monitor. Existing connectors, including Docs and Sheets, are working again, and Claude Managed Agents and Claude Meetings are recovering. Adding a new connector on claude.ai is temporarily unavailable. Scheduled tasks and routines can run more than two hours late and some runs have been skipped, and Claude Security scans, reviews and project setup remain delayed. We'll share another update soon.",
        "created_at": "2026-11-13T15:33:14.937Z"
      },
      {
        "native_id": "0pc8dxgpmz8s",
        "status": "resolved",
        "body": "The issue affecting multiple surfaces has been resolved.",
        "created_at": "2026-11-13T15:38:49.356Z"
      }
    ],
