    "updates": [
      {
        "native_id": "fzwnwhk3mz10",
        "status": "investigating",
        "body": "We are currently investigating an issue delaying the ingestion of Real User Monitoring (RUM) measure metrics, custom process metrics, and a subset of distribution metrics for some customers.\n\nAs a result, some users may see delays or gaps in RUM, custom process, and distribution metrics. To prevent false alerts caused by delayed data, affected monitors will not notify and will automatically resume once current data is available. All other monitors will operate normally. No data has been lost.\n\nWe will provide further updates as the situation progresses.",
        "created_at": "2026-07-29T15:41:51.97Z"
      },
      {
        "native_id": "9h5whzp27mh4",
        "status": "investigating",
        "body": "We are continuing to investigate this issue.",
        "created_at": "2026-07-29T15:42:12.792Z"
      },
      {
        "native_id": "kcx3s1f0m816",
        "status": "identified",
        "body": "The issue has been identified and a fix is being implemented.",
        "created_at": "2026-07-29T16:35:04.667Z"
      },
      {
        "native_id": "b8qqwhl738hm",
        "status": "identified",
        "body": "The RUM delays have been resolved. We're continuing to mitigate the issues on distribution metrics.",
        "created_at": "2026-07-29T16:53:24.445Z"
      },
