    "components": [
      "macOS Jobs"
    ],
    "updates": [
      {
        "native_id": "xjrp6rvl77zv",
        "status": "identified",
        "body": "We have identified a network outage that is preventing Mac jobs from starting. This include m4pro.medium and m4pro.large resource types.\n\nWe are working with our infrastructure provider to restore service.\n\nWe will update this incident as we work to resolve the issue.",
        "created_at": "2026-05-31T18:15:41.835Z"
      },
      {
        "native_id": "z3f4lcq603sx",
        "status": "identified",
        "body": "We are continuing to work on resolving the networking issue for Mac jobs.",
        "created_at": "2026-05-31T19:09:16.934Z"
      },
      {
        "native_id": "z9nmh3wk90px",
        "status": "identified",
        "body": "We are still seeing failures with Mac jobs starting due to high network latency and packet loss. We will continue to update as we have more information on a resolution.",
        "created_at": "2026-05-31T20:05:30.284Z"
      },
      {
        "native_id": "wr23tykg6q0c",
        "status": "identified",
        "body": "We are continuing to investigate failures with Mac jobs starting due to high network latency and packet loss. Our engineers remain engaged with our infrastructure provider to restore service. \n\nWe will provide another update within the hour, or sooner if circumstances change. We thank you for your patience while our engineers work to resolve this.",
        "created_at": "2026-05-31T21:24:53.883Z"
      },
      {
        "native_id": "hyzzgflkpy73",
        "status": "identified",
        "body": "Mac jobs are continuing to experience failures. Our infrastructure provider is reporting they are experiencing a DDoS attack causing high network latency and packet loss for our Mac fleet. We are working to bring up additional capacity to restore service.\n\nWe will continue to update as more information is available.",
        "created_at": "2026-05-31T22:38:04.474Z"
      },
      {
        "native_id": "9dfkrpms8gcl",
        "status": "monitoring",
        "body": "We are seeing Mac jobs starting successfully and improved network connectivity to the Mac fleet. We will continue to monitor the recovery.",
        "created_at": "2026-06-01T00:24:15.594Z"
      },
      {
        "native_id": "1l3d7l4v58zy",
        "status": "monitoring",
        "body": "We have processed the backlog of Mac jobs and job start times are recovering to normal parameters.",
        "created_at": "2026-06-01T00:42:15.582Z"
      },
      {
        "native_id": "jwry2rkn7vyj",
        "status": "resolved",
        "body": "Mac jobs have now fully recovered.\n\nThank you for your patience during this incident.",
        "created_at": "2026-06-01T00:45:07.993Z"
      }
