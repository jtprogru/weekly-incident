    "updates": [
      {
        "native_id": "2428",
        "status": "investigating",
        "body": "There is a short-term loss of connectivity between external services and Yandex Cloud. The problem is localized at the external contour level: the operation of internal services and the data-plane is not disrupted. The development team is already working on the restoration.",
        "created_at": "2026-05-27T12:29:58.563Z"
      },
      {
        "native_id": "2430",
        "status": "unknown",
        "body": "At 15:33 Moscow time (UTC+3), we are seeing the restoration of most services. The developers continue to investigate the situation.",
        "created_at": "2026-05-27T12:43:48.433Z"
      },
      {
        "native_id": "2433",
        "status": "resolved",
        "body": "The availability of external services has been fully restored. The cause of the unavailability has been fixed. The operation of the data-plane and internal systems remained stable throughout the incident.\nThe problem is not expected to happen again.\nIf you have any questions or problems, please contact technical support.",
        "created_at": "2026-05-27T12:58:11.956Z"
      }
    ],
    "first_seen_at": "2026-10-13T13:02:26.166769166Z",
