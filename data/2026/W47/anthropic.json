    "url": "https://stspg.io/01qq3kzyyqzl",
    "impact": "minor",
    "status": "resolved",
    "started_at": "2026-11-16T15:10:15.16Z",
    "resolved_at": "2026-11-19T02:15:05.834Z",
    "duration_minutes": 3544,
    "components": [
      "claude.ai"
    ],
    "updates": [
      {
        "native_id": "177nx45nsdvg",
        "status": "investigating",
        "body": "We are investigating an issue preventing Claude from joining new calls in Claude Meetings (beta). Calls already in progress are not affected, and core functionality is not impacted. We will provide an update as soon as possible.",
        "created_at": "2026-11-16T15:10:15.235Z"
      },
      {
        "native_id": "cknf7f0qymmq",
        "status": "investigating",
        "body": "We are continuing to investigate an issue preventing Claude from joining new calls in Claude Meetings (beta).",
        "created_at": "2026-11-16T15:12:56.268Z"
      },
      {
        "native_id": "xf4fg7rhhsbk",
        "status": "investigating",
        "body": "We have temporarily paused Auto-join while we work on this. Adding Claude to a call by hand is also affected. Calls already in progress are not affected. We will provide another update as soon as possible.",
        "created_at": "2026-11-16T16:27:03.835Z"
      },
      {
        "native_id": "rq8n1dwxvw7k",
        "status": "investigating",
        "body": "Claude may still be unable to join some calls in Claude Meetings (beta), and Auto-join remains paused. Calls already in progress and other Claude features are not affected. We expect this to take some time to fully resolve and will post an update when the status changes.",
        "created_at": "2026-11-16T18:10:10.24Z"
      },
      {
        "native_id": "7njxwk3s0rln",
        "status": "identified",
        "body": "Claude Meetings (beta) saw higher than expected demand today, and Claude was unable to join many calls. We have put mitigations in place and are continuing to monitor and improve join reliability.\n\nClaude Meetings is now re-enabled for all Enterprise customers, though Claude may take a little longer than usual to join. Adding Claude to new calls and Auto-join remain paused for Team customers. We will share more updates as we expand capacity and begin restoring the feature for Team customers.",
        "created_at": "2026-11-17T02:02:57.704Z"
      },
      {
        "native_id": "qyyn9x1x5gpf",
        "status": "identified",
        "body": "Claude Meetings (beta) is joining calls more reliably, and we are monitoring it. It remains enabled for all Enterprise customers. Team customers can again add Claude to new calls manually, and Auto-join is being restored gradually for Team customers.",
        "created_at": "2026-11-17T23:39:43.919Z"
      },
      {
        "native_id": "rw17j5rnvscn",
        "status": "resolved",
        "body": "Claude Meetings (beta) is joining calls normally. Enterprise and Team customers can add Claude to calls. Auto-join is available for all Enterprise customers and some Team customers. We'll continue rolling out auto-join to additional Team customers in the coming days.",
        "created_at": "2026-11-19T02:15:05.834Z"
      }
    ],
