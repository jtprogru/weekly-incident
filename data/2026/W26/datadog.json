    "components": [],
    "updates": [
      {
        "native_id": "fz4krvxsb07f",
        "status": "identified",
        "body": "We have identified increased latency processing APM Trace Metrics and are working on a fix.\nAs a result of this issue, some users may see delayed APM Trace Metrics since 13:07 UTC.\nTo prevent false monitor alerts due to delayed data, monitors affected by the delay will not notify and will automatically resume once current data is available. All other monitors will operate normally..",
        "created_at": "2026-06-26T13:38:59.166Z"
      },
      {
        "native_id": "qbkxb2sg9g6g",
