    ],
    "updates": [
      {
        "native_id": "2414",
        "status": "investigating",
        "body": "We are experiencing delays in processing operations for creating and managing virtual machines. This may affect the creation time of resources in Compute Cloud, Managed Service for Kubernetes, as well as managed databases (MySQL, PostgreSQL, ClickHouse, and others).",
        "created_at": "2026-05-22T09:22:14.806Z"
      },
      {
        "native_id": "2415",
        "status": "unknown",
        "body": "Due to ongoing restoration work, operations to create and manage resources in the Compute Cloud service are temporarily unavailable. This makes it impossible to create and modify resources in dependent services: Managed Service for Kubernetes, Managed Service for MySQL, Managed Service for PostgreSQL and other managed databases.\nExisting previously created resources continue to work.",
        "created_at": "2026-05-22T11:06:30.398Z"
      },
      {
        "native_id": "2416",
        "status": "unknown",
        "body": "We have restored access to operations. Currently, there may be slight delays in processing.",
        "created_at": "2026-05-22T11:59:32.201Z"
      },
      {
        "native_id": "2419",
        "status": "resolved",
        "body": "The services have been fully restored.",
        "created_at": "2026-05-22T14:37:03.434Z"
      }
    ],
    "first_seen_at": "2026-10-13T13:02:26.166769166Z",
