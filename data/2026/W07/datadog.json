      },
      {
        "native_id": "pf889yckpp1m",
        "status": "identified",
        "body": "Teams continue to work to mitigate the impact of this issue. At this time, APM Trace Processing, APM Trace Monitors are still delayed and Distribution Metrics monitors are delayed starting from 21:35 UTC",
        "created_at": "2026-02-11T21:51:27.495Z"
      },
      {
