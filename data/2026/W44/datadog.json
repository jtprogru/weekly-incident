    "updates": [
      {
        "native_id": "n0664rcgljmt",
        "status": "investigating",
        "body": "We are currently investigating an issue affecting Workflow Automation, App Builder, Bits Code, and Agent Builder in our US1 datacenter.\n\nDuring this time, some users may experience:\n- Workflows containing JavaScript or Python actions failing to run, including workflows used for incident and on-call automation\n- App Builder apps that use JavaScript or Python failing, or parts of those apps not working as expected\n- Bits Code sessions failing to start or complete\n- Agent Builder agents with Bits Code enabled being unable to start code sessions or use bash tools\n\nOur engineering teams are actively working to resolve the issue, and we’ll follow up with more information shortly.",
        "created_at": "2026-10-26T17:26:43.661Z"
      },
      {
        "native_id": "ktysls458zjx",
        "status": "identified",
        "body": "We have identified the underlying issue and are working on a fix.",
        "created_at": "2026-10-26T17:30:48.098Z"
      },
      {
        "native_id": "nwzv79f897qm",
        "status": "identified",
        "body": "We have identified the underlying issue and are working on a fix.",
        "created_at": "2026-10-26T17:31:54.225Z"
      },
      {
