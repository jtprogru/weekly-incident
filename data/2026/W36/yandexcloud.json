    "native_id": "1993",
    "title": "Partial unavailability of the Cloud Backup service",
    "url": "https://status.yandex.cloud/en/incidents/1993",
    "impact": "minor",
    "status": "resolved",
    "started_at": "2026-09-02T07:00:00Z",
    "resolved_at": "2026-09-02T09:51:00Z",
    "duration_minutes": 171,
    "components": [
      "Cloud Backup"
    ],
    "updates": [
      {
        "native_id": "2683",
        "status": "unknown",
        "body": "From 10:00 to 13:00 Moscow time, the service will be operated by the backup provider.\nAt this point, it can be observed:\n– Unavailability of operations for connecting virtual machines to the service, management of backup and backup policies through the user interface, CLI and API for up to 60 minutes;\n– There may be problems in starting and executing backup tasks, as well as a drop in the speed of creating and restoring backups.",
        "created_at": "2026-09-02T06:51:08.667Z"
      },
      {
        "native_id": "2685",
        "status": "resolved",
        "body": "The provider's work has been completed, and the service is operating normally.",
        "created_at": "2026-09-02T11:40:28.964Z"
      }
    ],
    "first_seen_at": "2026-10-13T13:02:26.166769166Z",
    "raw": {
      "comments": [
        {
          "content": "\u003cp\u003eThe provider's work has been completed, and the service is operating normally.\u003c/p\u003e\n",
