    "updates": [
      {
        "native_id": "zvm8p6gkxq9d",
        "status": "investigating",
        "body": "We are investigating an outage affecting Grafana Incident in the US Central region (prod-us-central-0). Customers are unable to create, view, or query Incidents, and requests to the Incident public API are timing out. All customers in this region are affected.\n\nGrafana OnCall is not impacted — alert ingestion, alert group creation, and notification delivery are all operating normally.",
        "created_at": "2026-08-25T10:39:49.26Z"
      },
      {
        "native_id": "jkrj5gd7k3dn",
        "status": "monitoring",
        "body": "A fix has been applied and Incident Management in US Central is recovering. The Incident public API is responding normally, and customers can create, view, and query Incidents again. We are continuing to monitor the recovery to confirm the service is fully stable.",
        "created_at": "2026-08-25T10:49:56.945Z"
      },
      {
        "native_id": "psfx0ggj8yl1",
        "status": "monitoring",
        "body": "We are continuing to monitor for any further issues.",
