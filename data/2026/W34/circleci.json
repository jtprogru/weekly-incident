    "components": [],
    "updates": [
      {
        "native_id": "bmmv0h280h81",
        "status": "identified",
        "body": "GitHub has reported an incident that is impacting CircleCI pipeline triggering and logging in: https://www.githubstatus.com/incidents/zkxwbgr0cnmx\n\nJobs that are in flights are running, but status reporting to GitHub Pull Requests may fail.",
        "created_at": "2026-08-17T14:04:21.278Z"
      },
      {
        "native_id": "rq77npzj7drn",
        "status": "identified",
        "body": "We are continuing to see high error rates on GitHub APIs and reduced webhook traffic.\n\nWe will continue to provide updates as more information becomes available.",
        "created_at": "2026-08-17T14:25:29.256Z"
      },
      {
        "native_id": "y5d9scw1wx0s",
        "status": "identified",
        "body": "We are continuing to see high error rates on GitHub's APIs and reduced webhook traffic. Customers using GitHub as their VCS may experience impact to their CircleCI platform experience as a result. This is directly linked to the incident GitHub is experiencing: https://www.githubstatus.com/incidents/zkxwbgr0cnmx\n\nWe will provide updates as more information becomes available.",
        "created_at": "2026-08-17T15:49:39.558Z"
      },
      {
        "native_id": "ycdg4w7xpnqb",
        "status": "monitoring",
        "body": "We have started to observe improved stability in GitHub APIs. We will continue to monitor as they recover.",
        "created_at": "2026-08-17T16:22:24.867Z"
      },
      {
        "native_id": "nngjkxns5zt9",
        "status": "monitoring",
        "body": "GitHub API error rates and latencies appear to have recovered. We will continue to monitor.",
        "created_at": "2026-08-17T17:01:08.219Z"
      },
      {
        "native_id": "cnh2m3b0nytc",
        "status": "monitoring",
        "body": "Some of GitHub's APIs are still degraded, resulting in a small number of failures relating to commit status updates and hook processing. We will continue to do our best to mitigate these effects.",
        "created_at": "2026-08-17T17:23:06.238Z"
      },
      {
        "native_id": "kctv5w6hmjj7",
        "status": "resolved",
        "body": "GitHub's APIs appear to be operating normally.",
        "created_at": "2026-08-17T19:05:30.477Z"
      }
