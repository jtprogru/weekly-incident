    "title": "Claude for Microsoft 365 add-in missing for some users",
    "url": "https://stspg.io/ffdq2qfv8frk",
    "impact": "major",
    "status": "monitoring",
    "started_at": "2026-11-24T00:10:40.012Z",
    "components": [
      "claude.ai"
    ],
    "updates": [
      {
        "native_id": "6jcm0vn1pcw5",
        "status": "investigating",
        "body": "We are investigating an issue causing the Claude add-in to disappear from Excel, Word, and PowerPoint on Mac for users signed in to Microsoft Office with a personal Microsoft account. Work and school accounts do not appear affected, and Claude's other apps are unaffected. We will provide an update as soon as possible.",
        "created_at": "2026-11-24T00:10:40.111Z"
      },
      {
        "native_id": "xptdjq6st8lw",
        "status": "investigating",
        "body": "We are continuing to investigate an issue causing the Claude add-in to disappear from Excel, Word, and PowerPoint on Mac for users signed in to Microsoft Office with a personal Microsoft account. In the meantime, we recommend using the web versions of Excel, Word, and PowerPoint at office.com, where Claude remains available for many users. Work and school accounts do not appear affected. We will provide another update as soon as possible.",
        "created_at": "2026-11-24T01:31:04.494Z"
      },
      {
        "native_id": "nkf17x170x9n",
        "status": "identified",
        "body": "We have identified an issue with an upstream provider that is causing the Claude add-in to disappear from Excel, Word, and PowerPoint on Mac for users signed in to Microsoft Office with a personal Microsoft account. We are in contact with them. In the meantime, we recommend using the web versions of Excel, Word, and PowerPoint at office.com, where Claude remains available for many users. We will provide another update as soon as possible.",
        "created_at": "2026-11-25T20:21:12.137Z"
      },
      {
        "native_id": "7d8r8dpq7ymm",
        "status": "monitoring",
        "body": "Our upstream provider has applied a mitigation for the issue that caused the Claude add-in to disappear from Excel, Word, and PowerPoint on Mac for users signed in to Microsoft Office with a personal Microsoft account, and we are monitoring for recovery. If Claude is still missing, try adding it again from Microsoft Marketplace, or use the web versions of Excel, Word, and PowerPoint at office.com, where Claude remains available for many users. We will provide another update as soon as possible.",
        "created_at": "2026-11-27T19:48:22.149Z"
      }
    ],
