      },
      {
        "native_id": "b907rnvmr37d",
        "status": "investigating",
        "body": "We are investigating delays affecting pull request updates and webhook deliveries. Increased load on our event streaming platform is contributing to hotspots. We are shifting traffic away from affected areas and adding processing capacity; impact is ongoing while these mitigations take effect.",
        "created_at": "2026-10-21T15:36:47.783Z"
      },
      {
        "native_id": "w01txk0w9f8w",
        "status": "investigating",
        "body": "We continue to see delays affecting pull request updates, webhook deliveries, and audit log events. The event streaming platform is showing signs of recovery, and we are monitoring as the impact continues.",
