    "updates": [
      {
        "native_id": "dg1nzp9ql40c",
        "status": "investigating",
        "body": "We are investigating increased latency processing Events generated by RUM, Trace Analytics, Service Checks, CI Visibility, Cloud Network Monitoring, and Error Tracking.\nAs a result of this issue, some users may see delays or gaps in the event stream or for event queries on dashboards since Sep 30, 2026, 5:25 PM UTC\nTo prevent false monitor alerts due to delayed data, monitors affected by the delay will not notify and will automatically resume once current data is available. All other monitors will operate normally.",
        "created_at": "2026-09-30T18:02:40.695Z"
      },
      {
        "native_id": "39nz6p6kqzbd",
        "status": "identified",
        "body": "We have identified the issue and are working on a mitigation strategy.",
        "created_at": "2026-09-30T18:05:31.386Z"
      },
