    "updates": [
      {
        "native_id": "wckqxnjv9vzs",
        "status": "investigating",
        "body": "We are investigating elevated error rates affecting Claude.ai (including the desktop and mobile apps), Claude Code and Claude Cowork. Users may see failed requests, errors loading or sending conversations, or be asked to sign in again; retrying may succeed. We will provide an update as soon as possible.",
        "created_at": "2026-09-29T14:21:37.364Z"
      },
      {
        "native_id": "7l2fk92vn46n",
        "status": "investigating",
        "body": "We are investigating elevated error rates affecting Claude.ai (including the desktop and mobile apps), Claude Code and Claude Cowork. Some requests to the Claude API are also returning errors. We will provide an update as soon as possible.",
        "created_at": "2026-09-29T14:28:49.253Z"
      },
      {
        "native_id": "brb6lq479fzn",
        "status": "investigating",
        "body": "We are investigating reports of degraded performance affecting claude.ai, platform.claude.com, the Claude API, Claude Code, and Claude Cowork. We will provide an update as soon as possible.",
        "created_at": "2026-09-29T14:30:19.579Z"
      },
      {
        "native_id": "n48jph444trw",
        "status": "investigating",
        "body": "We have applied a mitigation and error rates have dropped substantially. Some sign-in attempts, account actions and Claude Code and Cowork sessions are still failing. We are continuing to work on a full fix.",
        "created_at": "2026-09-29T14:41:08.273Z"
      },
      {
        "native_id": "rn1gxrk6ct09",
        "status": "investigating",
        "body": "The errors that began at 14:00 UTC were mitigated at 14:36 UTC, and existing conversations are mostly working again. A second issue is preventing many users from signing in (single sign-on and Sign in with Apple are unavailable), starting new chats, voice conversations and Claude Code or Cowork sessions, making purchases, and uploading files. If you're signed in, please don't sign out. We're working on a fix and will post another update within 30 minutes.",
        "created_at": "2026-09-29T15:00:14.745Z"
      },
      {
        "native_id": "dbyttk4j4c9n",
        "status": "monitoring",
        "body": "Most services have recovered as of 14:59 UTC. Signing in, starting new chats, voice conversations, Claude Code and Cowork sessions, purchases and file uploads are working again. Some messages sent between 14:00 and 14:59 UTC may not have been saved. We are monitoring closely and will post another update within 30 minutes.",
        "created_at": "2026-09-29T15:11:27.45Z"
      },
      {
        "native_id": "ws4y7dd82g11",
        "status": "monitoring",
        "body": "All services have been operating normally since 14:59 UTC. We are continuing to monitor.",
