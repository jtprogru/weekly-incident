    "updates": [
      {
        "native_id": "y9jr557n4093",
        "status": "investigating",
        "body": "We are investigating elevated errors and slow responses affecting the Microsoft 365 connector. Requests to mail, SharePoint, Teams chat and calendar through the connector may fail, and new connections to the connector may not complete. We will provide an update as soon as possible.",
        "created_at": "2026-11-12T17:52:45.043Z"
      },
      {
        "native_id": "3175zg4x0lch",
        "status": "identified",
        "body": "We have identified an issue with an upstream provider affecting the Microsoft 365 connector. Mail, calendar and search tools are failing for most requests, and new connections to the connector may not complete. We are in contact with them and will provide an update as soon as possible.",
        "created_at": "2026-11-12T18:34:20.058Z"
      },
      {
        "native_id": "ztjnr8s5q82x",
        "status": "identified",
        "body": "We are continuing to work with our upstream provider on this issue. Mail, calendar and search tools in the Microsoft 365 connector are still failing for most requests. Claude for Outlook is also affected: mail and calendar actions may fail, and some users may not be able to open the add-in. We will provide another update within the hour.",
        "created_at": "2026-11-12T20:28:28.214Z"
      },
      {
        "native_id": "11466g495qtb",
        "status": "identified",
        "body": "We are continuing to work with our upstream provider, who is restarting affected servers. Mail, calendar and search tools in the Microsoft 365 connector are still failing for most requests, and Claude for Outlook remains affected. We will provide another update as soon as we have more information.",
